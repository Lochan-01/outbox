{
  "name": "email-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend service for Email Job Scheduler",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@bull-board/api": "^5.14.0",
    "@bull-board/express": "^5.14.0",
    "@elastic/elasticsearch": "^8.12.0",
    "@prisma/client": "^5.9.1",
    "axios": "^1.6.7",
    "bullmq": "^5.1.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.2",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "nodemailer": "^6.9.9",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.8",
    "prisma": "^5.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
